PORT=3000
NODE_ENV=development

# Meta WhatsApp Cloud API
VERIFY_TOKEN=replace-with-a-long-random-string
WHATSAPP_TOKEN=replace-with-a-permanent-system-user-access-token
PHONE_NUMBER_ID=123456789012345
META_APP_SECRET=replace-with-your-meta-app-secret
GRAPH_API_VERSION=v20.0

# Google Gemini
GEMINI_API_KEY=replace-with-your-google-ai-studio-key
GEMINI_MODEL=gemini-2.5-flash

# Supabase (server-side service role key; never expose it to a browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Sales configuration
AGENCY_NAME=Your Digital Agency
DISCOVERY_CALL_URL=https://cal.com/your-agency/15min
